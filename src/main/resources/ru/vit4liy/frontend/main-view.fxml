<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="650.0" prefWidth="1100.0"
      stylesheets="@main.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.vit4liy.frontend.MainController">

  <MenuBar VBox.vgrow="NEVER">
    <menus>
      <Menu mnemonicParsing="false" text="Данные">
        <items>
          <MenuItem text="Импорт (затирание)" onAction="#onImportOverwrite"/>
          <MenuItem text="Импорт (добавочный)" onAction="#onImportAppend"/>
          <MenuItem text="Экспорт" onAction="#onExport"/>
        </items>
      </Menu>
    </menus>
  </MenuBar>

  <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
    <tabs>
      <Tab fx:id="locationsTab" text="📍 Локации">
        <fx:include fx:id="locations" source="tabs/locations-tab.fxml"/>
      </Tab>
      <Tab fx:id="devicesTab" text="🖨 Устройства">
        <fx:include fx:id="devices" source="tabs/devices-tab.fxml"/>
      </Tab>
      <Tab fx:id="employeesTab" text="👥 Сотрудники">
        <fx:include fx:id="employees" source="tabs/employees-tab.fxml"/>
      </Tab>
      <Tab fx:id="dictionariesTab" text="📚 Справочники">
        <fx:include fx:id="dictionaries" source="tabs/dictionaries-tab.fxml"/>
      </Tab>
      <Tab fx:id="dataEntryTab" text="➕ Ввод данных">
        <fx:include fx:id="dataEntry" source="tabs/data-entry-view.fxml"/>
      </Tab>
    </tabs>
  </TabPane>
</VBox>